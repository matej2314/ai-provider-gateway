{
  "name": "ai-provider-gateway",
  "version": "1.0.0",
  "description": "",
  "author": "Mateusz Śliwowski <mateo2314@gmail.com>",
  "private": true,
  "license": "MIT",
  "bin": {
    "gateway": "./bin/gateway-cli-wrapper.js"
  },
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "config:validate": "ts-node scripts/validate-config.ts",
    "cli": "node bin/gateway-cli-wrapper.js",
    "build:cli": "npm run build",
    "openapi:export": "npm run build && node dist/src/swagger/export-openapi.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:cli": "jest --config ./test/jest-cli.json",
    "test:cli:watch": "jest --config ./test/jest-cli.json --watch",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:all": "npm test && npm run test:e2e",
    "pretest:integration": "npm run test:integration:redis:up",
    "posttest:integration": "npm run test:integration:redis:down",
    "test:integration": "jest --config ./test/jest-integration.json --runInBand",
    "test:integration:redis:up": "docker compose -f test/integration/docker-compose.redis.yml up -d --wait",
    "test:integration:redis:down": "docker compose -f test/integration/docker-compose.redis.yml down -v",
    "typecheck:coverage": "type-coverage"
  },
  "typeCoverage": {
    "atLeast": 99,
    "detail": true,
    "ignoreFiles": [
      "dist/**",
      "test/**",
      "**/*.spec.ts",
      "scripts/**"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.93.0",
    "@google/genai": "^1.52.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.27",
    "@nestjs/platform-express": "^11.1.27",
    "@nestjs/swagger": "^11.4.4",
    "@sentry/nestjs": "^10.53.1",
    "boxen": "^6.2.1",
    "chalk": "^4.1.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "inquirer": "^8.2.6",
    "ioredis": "^5.10.1",
    "js-yaml": "^4.2.0",
    "nest-commander": "^3.20.1",
    "openai": "^6.44.0",
    "ora": "^5.4.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^14.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.1.27",
    "@types/express": "^5.0.0",
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^30.0.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.0.0",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "type-coverage": "^2.29.7",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testPathIgnorePatterns": [
      "<rootDir>/cli/"
    ],
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s",
      "!cli/**"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
