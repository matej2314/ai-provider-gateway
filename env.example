# ==========================================
# AI Provider Gateway — przykład .env
# ==========================================
# Skopiuj jako `.env` w katalogu głównym i uzupełnij wartości:
#   cp env.example .env
#
# Nazwy zmiennych z sekcji Auth / Providers / Clients MUSZĄ być zgodne
# z *KeyRef / *Ref w gateway.config.yaml (poniżej: szablon PLACEHOLDER).
# Po `gateway config:init` wizard wygeneruje własne nazwy (np. MASTER_KEY,
# ANTHROPIC_PRIMARY_API_KEY, GATEWAY_KEY_WEBAPP) — wtedy zaktualizuj .env.
#
# NIGDY nie commituj pliku `.env` z prawdziwymi sekretami.

# --- Server ---
APP_VERSION=1.0.0
PORT=3000
NODE_ENV=development
# Poza production Swagger jest włączony, chyba że SWAGGER_ENABLED=false.
# W production UI/JSON tylko gdy SWAGGER_ENABLED=true.
SWAGGER_ENABLED=true

# --- Gateway auth (masterKeyRef / clients[].gatewayKeyRef w YAML) ---
MASTER_KEY_PLACEHOLDER=
GATEWAY_KEY_PLACEHOLDER=

# --- Provider secrets (providers[].apiKeyRef [/ baseUrlRef] w YAML) ---
ANTHROPIC_API_KEY_PLACEHOLDER=
# Przykłady po pełnej konfiguracji (odkomentuj i dopasuj do YAML):
# ANTHROPIC_PRIMARY_API_KEY=
# GOOGLE_PRIMARY_API_KEY=
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OLLAMA_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# --- Cache odpowiedzi (opcjonalnie) ---
# Domyślnie w kodzie: CACHE_ENABLED=false, CACHE_BACKEND=noop.
# Poniżej włączone pod lokalny Redis — wyłącz, jeśli nie uruchamiasz Redis.
CACHE_ENABLED=true
CACHE_BACKEND=redis
CACHE_TTL=3600
CACHE_KEY_PREFIX=aigw:

# --- Redis ---
# Wymagany gdy: (CACHE_ENABLED=true AND CACHE_BACKEND=redis)
#             LUB RATE_LIMIT_SMART_ENABLED=true
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=aigw:

# --- Smart rate limiting (per X-Gateway-Key; wymaga Redis) ---
RATE_LIMIT_SMART_ENABLED=true
RATE_LIMIT_RPS_PER_KEY=10
RATE_LIMIT_BURST_PER_KEY=20
RATE_LIMIT_STREAMS_CONCURRENT=3
RATE_LIMIT_COOLDOWN_AFTER_429=60

# --- Logging ---
LOG_LEVEL=debug
LOG_ADAPTER=pino
LOG_PRETTY=true

# --- Observability / metrics ---
# METRICS_BACKEND: prometheus | noop  (w production często prometheus → GET /metrics)
METRICS_BACKEND=noop
# AI_METRICS_BACKEND: sentry | noop   (metryki LLM / span GenAI)
AI_METRICS_BACKEND=noop
# ERROR_REPORTING_ADAPTER: sentry | noop
ERROR_REPORTING_ADAPTER=noop

SENTRY_ENABLED=false
SENTRY_DSN=
# true → treść wiadomości na spanach (m.in. widok Conversations w Sentry)
SENTRY_INCLUDE_PROMPTS=true
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
