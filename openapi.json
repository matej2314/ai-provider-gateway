{
  "openapi": "3.1.0",
  "info": {
    "title": "AI Provider Gateway API",
    "version": "0.4.0",
    "description": "REST API dla chat completions (JSON) oraz streamingu (SSE) nad adapterami Anthropic / Google Gemini.\n\n**Zakres produktu (nagłówek `PLAN_IMPLEMENTACJI.md`):** rdzeń MVP = routing + chat + streaming (Fazy 1–2 oraz 4); providery MVP = Anthropic + Google Gemini; trwa v1 (m.in. Fazy 3 oraz 5–7). **System prompt** jest składany po stronie serwera z plików w `src/config/system-prompt/` (warstwy MASTER / MAIN / opcjonalnie per alias); w `messages[]` dozwolone są wyłącznie role `user` i `assistant` — patrz `docs/konfiguracja.md`, dokumentacja decyzji: `SYSTEM_PROMPTS_REFACTOR-READY.md`.\n\nSchematy żądań i odpowiedzi sukcesu odpowiadają kodowi w `src/`. Błędy zwracane są w **domyślnym formacie NestJS** (`statusCode`, `message`, opcjonalnie `error`). Dodatkowe pola body (`params`), ujednolicony envelope z polem `code` oraz nagłówek `x-request-id` są zaplanowane w `PLAN_IMPLEMENTACJI.md` (Faza 5). Opcjonalna warstwa cache / Redis (port + adapter) jest opisana w `REDIS_IMPLEMENTATION_PLAN.md` (start po zamknięciu Fazy 6).\n\nOpis ludzki: katalog `docs/` w repozytorium."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Przykład lokalny"
    }
  ],
  "tags": [
    { "name": "Health", "description": "Liveness/readiness" },
    { "name": "Chat", "description": "Chat completions (standard + streaming)" }
  ],
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": ["Health"],
        "operationId": "getHealth",
        "summary": "Healthcheck (liveness)",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" },
                "examples": {
                  "ok": {
                    "value": {
                      "status": "ok",
                      "message": "Gateway is running",
                      "timestamp": "2026-05-07T13:54:00.000Z"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat": {
      "post": {
        "tags": ["Chat"],
        "operationId": "postChat",
        "summary": "Chat (standard)",
        "description": "Pełna odpowiedź JSON. `requestId` w odpowiedzi jest generowany po stronie gateway (prefiks `req_`). Parametry wyjścia (`temperature`, `maxOutputTokens`) pochodzą obecnie z domyślnych wartości w konfiguracji aliasu (`gateway.config.yaml`), nie z body żądania. Pole `model` w odpowiedzi to ten sam alias co `modelAlias` z żądania (nie vendorowy `modelId`).",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatRequest" },
              "examples": {
                "minimal": {
                  "value": {
                    "modelAlias": "chat-default",
                    "messages": [{ "role": "user", "content": "Napisz krótkie streszczenie." }]
                  }
                },
                "multiTurn": {
                  "value": {
                    "modelAlias": "chat-default",
                    "messages": [
                      { "role": "user", "content": "Czym jest gateway?" },
                      { "role": "assistant", "content": "Warstwa pośrednia między klientem a LLM." },
                      { "role": "user", "content": "Podsumuj w jednym zdaniu." }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Odpowiedź gateway (standard)",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatResponse" },
                "examples": {
                  "okText": {
                    "value": {
                      "id": "gw_01H...",
                      "provider": "anthropic",
                      "model": "chat-default",
                      "output": { "type": "text", "text": "..." },
                      "usage": { "inputTokens": 123, "outputTokens": 456 },
                      "requestId": "req_..."
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Walidacja DTO (`ValidationPipe`), nieznany `modelAlias` lub instancja providera (`BadRequestException`).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NestHttpExceptionBody" },
                "examples": {
                  "validationFailed": {
                    "value": {
                      "statusCode": 400,
                      "message": ["modelAlias must be a string"],
                      "error": "Bad Request"
                    }
                  },
                  "unknownAlias": {
                    "value": {
                      "statusCode": 400,
                      "message": "Model alias unknown-alias not found in config",
                      "error": "Bad Request"
                    }
                  }
                }
              }
            }
          },
          "500": {
            "description": "Nieobsłużony wyjątek (np. błąd SDK providera) — kształt jak pozostałe odpowiedzi Nest.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NestHttpExceptionBody" }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat/stream": {
      "post": {
        "tags": ["Chat"],
        "operationId": "postChatStream",
        "summary": "Chat (streaming)",
        "description": "Streaming jako Server-Sent Events (`text/event-stream`). Sekwencja: `meta` (1×), `delta` (0..n), `done` (1×). Pole `data` dla `done` jest obecnie **pustym obiektem** `{}` (`ChatService.executeStream`).\n\nJeśli walidacja body lub wczesny `BadRequestException` zajdzie **przed** wysłaniem nagłówków SSE, klient dostanie JSON w formacie Nest (jak przy `POST /chat`). Po rozpoczęciu strumienia błąd zwykle kończy połączenie bez pełnego JSON.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatRequest" },
              "examples": {
                "minimal": {
                  "value": {
                    "modelAlias": "chat-default",
                    "messages": [{ "role": "user", "content": "Powiedz coś krótko." }]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE stream",
            "content": {
              "text/event-stream": {
                "schema": { "type": "string", "description": "Strumień SSE (tekst). Każde zdarzenie kończy się podwójnym znakiem nowej linii." },
                "examples": {
                  "sse": {
                    "value": "event: meta\ndata: {\"id\":\"gw_01H...\",\"provider\":\"anthropic\",\"model\":\"claude-...\",\"requestId\":\"req_...\"}\n\nevent: delta\ndata: {\"text\":\"Cześć\"}\n\nevent: delta\ndata: {\"text\":\"!\"}\n\nevent: done\ndata: {}\n"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Walidacja DTO lub streaming niedozwolony dla aliasu / adaptera (przed rozpoczęciem body SSE).",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/NestHttpExceptionBody" },
                "examples": {
                  "streamingNotSupported": {
                    "value": {
                      "statusCode": 400,
                      "message": "Streaming not supported for this model",
                      "error": "Bad Request"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status", "message", "timestamp"],
        "properties": {
          "status": { "type": "string", "const": "ok" },
          "message": { "type": "string", "minLength": 1 },
          "timestamp": { "type": "string", "format": "date-time" }
        }
      },
      "NestHttpExceptionBody": {
        "type": "object",
        "description": "Domyślny format odpowiedzi błędu NestJS (HttpException / ValidationPipe).",
        "required": ["statusCode", "message"],
        "properties": {
          "statusCode": { "type": "integer", "minimum": 400, "maximum": 599 },
          "message": {
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } }
            ]
          },
          "error": { "type": "string" }
        }
      },
      "ChatRole": {
        "type": "string",
        "enum": ["user", "assistant"],
        "description": "Zgodnie z `ChatMessageDto`: rola `system` w API jest zablokowana — system prompt ustala gateway z plików (`src/config/system-prompt/`)."
      },
      "ChatMessage": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": { "$ref": "#/components/schemas/ChatRole" },
          "content": { "type": "string", "minLength": 1 }
        }
      },
      "ChatRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["modelAlias", "messages"],
        "properties": {
          "modelAlias": {
            "type": "string",
            "minLength": 1,
            "description": "Alias modelu z `gateway.config.yaml`. Mapowany na providera i vendorowy `modelId`."
          },
          "messages": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/components/schemas/ChatMessage" }
          }
        }
      },
      "SseMetaPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "model", "requestId"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "Identyfikator odpowiedzi gateway (prefiks `gw_`)." },
          "provider": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "requestId": { "type": "string", "minLength": 1, "description": "Id korelacyjne (prefiks `req_`)." }
        }
      },
      "SseDeltaPayload": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string" }
        }
      },
      "SseDonePayload": {
        "type": "object",
        "additionalProperties": false,
        "description": "Obecna implementacja emituje pusty obiekt.",
        "properties": {}
      },
      "ChatOutputText": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "text"],
        "properties": {
          "type": { "type": "string", "const": "text" },
          "text": { "type": "string" }
        }
      },
      "ChatUsage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "inputTokens": { "type": "integer", "minimum": 0 },
          "outputTokens": { "type": "integer", "minimum": 0 },
          "totalTokens": { "type": "integer", "minimum": 0 }
        }
      },
      "ChatResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "provider", "model", "output", "requestId"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "provider": { "type": "string", "minLength": 1 },
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "Alias modelu z żądania (`modelAlias`). W odpowiedzi standardowej jest to ten sam identyfikator co w `POST /chat`; vendorowy `modelId` nie jest tutaj zwracany (w SSE `meta.model` jest rozwiązanym `modelId` — patrz `ChatService.executeStream`)."
          },
          "output": {
            "description": "Treść odpowiedzi (bieżąca wersja: wyłącznie tekst, `type: text`).",
            "oneOf": [{ "$ref": "#/components/schemas/ChatOutputText" }]
          },
          "usage": { "$ref": "#/components/schemas/ChatUsage" },
          "requestId": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
