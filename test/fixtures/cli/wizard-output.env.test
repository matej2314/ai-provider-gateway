APP_VERSION=1.0.0
PORT=3000
NODE_ENV=development
SWAGGER_ENABLED=true

MASTER_KEY=gw_master_key_wizard_fixture

ANTHROPIC_PRIMARY_API_KEY=sk-ant-wizard-fixture-key
GATEWAY_KEY_WEBAPP=gw_key_wizard_fixture

CACHE_ENABLED=false
CACHE_BACKEND=noop
CACHE_TTL=3600
CACHE_KEY_PREFIX=aigw:

REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=aigw:

RATE_LIMIT_SMART_ENABLED=false
RATE_LIMIT_RPS_PER_KEY=10
RATE_LIMIT_BURST_PER_KEY=20
RATE_LIMIT_STREAMS_CONCURRENT=3
RATE_LIMIT_COOLDOWN_AFTER_429=60

LOG_LEVEL=debug
LOG_ADAPTER=pino
LOG_PRETTY=true

METRICS_BACKEND=noop
ERROR_REPORTING_ADAPTER=noop
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_INCLUDE_PROMPTS=true
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
