{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "roots": ["<rootDir>/../src/cli"],
  "testMatch": ["**/*.spec.ts"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1"
  },
  "collectCoverageFrom": ["../src/cli/**/*.(t|j)s", "!../src/cli/**/*.spec.ts"],
  "coverageDirectory": "../coverage-cli"
}
