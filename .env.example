# At least one non-empty API key is required for startup (after trim): ANTHROPIC_API_KEY or GOOGLE_API_KEY.
# Each variable may be omitted if the other is set — see src/config/env.validation.ts.
MASTER_KEY=""

# Gateway keys for clients
GATEWAY_KEY_WEBAPP=""
GATEWAY_KEY_IDE_PLUGIN=""

# API keys for providers
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""

# REDIS and cache configuration for caching responses from providers

CACHE_ENABLED=true
CACHE_BACKEND=redis # redis or noop or memory
CACHE_TTL=3600
CACHE_KEY_PREFIX=aigw:

REDIS_HOST=""
REDIS_PORT=""
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_KEY_PREFIX=aigw:

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_TTL=60000  # TTL w ms (1 minuta)
RATE_LIMIT_MAX=100    # Max requests per TTL

# Smart Rate Limiting (per X-Gateway-Key)
RATE_LIMIT_SMART_ENABLED=true
RATE_LIMIT_RPS_PER_KEY=10           # Requests per second per key
RATE_LIMIT_BURST_PER_KEY=20         # Burst allowance per key
RATE_LIMIT_STREAMS_CONCURRENT=3     # Max concurrent streams per key
RATE_LIMIT_COOLDOWN_AFTER_429=60    # Cooldown seconds after provider 429

# CORS origins
CORS_ORIGINS=""

# Environment
NODE_ENV="development"
PORT=3000
