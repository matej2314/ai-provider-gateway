APP_VERSION=1.0.0
PORT=3000
NODE_ENV=development
SWAGGER_ENABLED=true
MASTER_KEY=
ANTHROPIC_MAIN_API_KEY=
GATEWAY_KEY_WEBAPP=
CACHE_ENABLED=true
CACHE_BACKEND=redis
CACHE_TTL=3600
CACHE_KEY_PREFIX=aigw:
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=aigw:
RATE_LIMIT_SMART_ENABLED=true
RATE_LIMIT_RPS_PER_KEY=10
RATE_LIMIT_BURST_PER_KEY=20
RATE_LIMIT_STREAMS_CONCURRENT=3
RATE_LIMIT_COOLDOWN_AFTER_429=60
LOG_LEVEL=debug
LOG_ADAPTER=pino
LOG_PRETTY=true
AI_METRICS_BACKEND=noop
METRICS_BACKEND=noop
ERROR_REPORTING_ADAPTER=noop
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_INCLUDE_PROMPTS=true
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1
