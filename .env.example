APP_VERSION=1.0.0
MASTER_KEY=""
CONFIG_VALIDATE_STRICT=true

# Gateway keys for clients
GATEWAY_KEY_WEBAPP=""
GATEWAY_KEY_IDE_PLUGIN=""

# API keys for providers
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""

# REDIS and cache configuration for caching responses from providers

CACHE_ENABLED=true
CACHE_BACKEND=redis # redis or noop or memory
CACHE_TTL=3600
CACHE_KEY_PREFIX=aigw:

REDIS_HOST=""
REDIS_PORT=""
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_KEY_PREFIX=aigw:

# Smart Rate Limiting (per X-Gateway-Key)
RATE_LIMIT_SMART_ENABLED=true
RATE_LIMIT_RPS_PER_KEY=10           #Default: Requests per second per key
RATE_LIMIT_BURST_PER_KEY=20         # Default:Burst allowance per key
RATE_LIMIT_STREAMS_CONCURRENT=3     # Default:Max concurrent streams per key
RATE_LIMIT_COOLDOWN_AFTER_429=60    # Cooldown seconds after provider 429

# Logging

LOG_LEVEL=info
LOG_ADAPTER=pino
LOG_PRETTY=true

# Sentry
SENTRY_DSN=""
SENTRY_INCLUDE_PROMPTS=true
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0

ERROR_REPORTING_ADAPTER=sentry # sentry or noop
METRICS_BACKEND=sentry # sentry or noop

# CORS origins
CORS_ORIGINS=""

# Environment
NODE_ENV="development"
PORT=3000
SWAGGER_ENABLED=true
