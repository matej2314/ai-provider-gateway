APP_VERSION=1.0.0
PORT=3000
# NODE_ENV="development"
NODE_ENV="production"
SWAGGER_ENABLED=true
CONFIG_VALIDATE_STRICT=true


ANTHROPIC_API_KEY=

GOOGLE_API_KEY=


MASTER_KEY=
GATEWAY_KEY_WEBAPP=
GATEWAY_KEY_IDE_PLUGIN=

CACHE_ENABLED=true
CACHE_BACKEND=redis
CACHE_TTL=3600
CACHE_KEY_PREFIX=aigw:

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=aigw:

# Smart Rate Limiting (per X-Gateway-Key)
RATE_LIMIT_SMART_ENABLED=true
RATE_LIMIT_RPS_PER_KEY=10           # Requests per second per key
RATE_LIMIT_BURST_PER_KEY=10         # Burst allowance per key
RATE_LIMIT_STREAMS_CONCURRENT=3     # Max concurrent streams per key
RATE_LIMIT_COOLDOWN_AFTER_429=75    # Cooldown seconds after provider 429

# Logging

LOG_LEVEL=info
LOG_ADAPTER=pino
LOG_PRETTY=true


# Sentry
SENTRY_DSN=""
SENTRY_INCLUDE_PROMPTS=true
SENTRY_ENABLED=true
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0

ERROR_REPORTING_ADAPTER=sentry # sentry or noop
METRICS_BACKEND=sentry # sentry or noop

