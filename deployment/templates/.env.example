# ==========================================
# AI Provider Gateway - Environment Config
# ==========================================
# Copy to .env in repo root. Names must match *KeyRef in gateway.config.yaml
# (deployment/templates/gateway.config.example.yaml uses PLACEHOLDER refs).

# Server
NODE_ENV=production
PORT=3000
APP_VERSION=1.0.0
SWAGGER_ENABLED=false

# Gateway Authentication (matches masterKeyRef in YAML template)
MASTER_KEY_PLACEHOLDER=

# Provider API Keys (matches apiKeyRef in YAML template)
ANTHROPIC_API_KEY_PLACEHOLDER=

# Client gateway key (matches gatewayKeyRef in YAML template)
GATEWAY_KEY_PLACEHOLDER=

# Cache (disabled in minimal boilerplate template)
CACHE_ENABLED=false
CACHE_BACKEND=noop
CACHE_TTL=3600
CACHE_KEY_PREFIX=aigw:

# Redis — Stack base uses port 6380 (see deployment/docker/docker-compose.redis.yml).
# In Docker networks: REDIS_HOST=redis (Compose service name). On host: localhost + 6380.
REDIS_HOST=redis
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=aigw:

# Rate Limiting (smart limit requires Redis — enable only with docker:up:redis)
RATE_LIMIT_SMART_ENABLED=false
RATE_LIMIT_RPS_PER_KEY=10
RATE_LIMIT_BURST_PER_KEY=20
RATE_LIMIT_STREAMS_CONCURRENT=5
RATE_LIMIT_COOLDOWN_AFTER_429=60

# Observability
LOG_LEVEL=info
LOG_ADAPTER=pino
LOG_PRETTY=false
SENTRY_DSN=
METRICS_BACKEND=noop
ERROR_REPORTING_ADAPTER=noop
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Grafana (docker-compose.monitoring.yml)
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Semantic cache (requires Redis Stack + Ollama embedding — npm run docker:up / infra:up)
# Host (start:dev): EMBEDDING_BASE_URL=http://localhost:11435
# Docker network: EMBEDDING_BASE_URL=http://ollama-embedding:11434
SEMANTIC_CACHE_ENABLED=true
EMBEDDING_BASE_URL=http://ollama-embedding:11434
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024
EMBEDDING_TIMEOUT_MS=5000
SEMANTIC_CACHE_MIN_SIMILARITY=0.85
# SEMANTIC_CACHE_TTL is deprecated and ignored. Semantic TTL = CACHE_TTL.
# SEMANTIC_CACHE_TTL=3600
SEMANTIC_CACHE_K=3
