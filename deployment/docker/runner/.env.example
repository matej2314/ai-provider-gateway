# GitHub runner registration (token is one-time; remove after first successful start)
RUNNER_REPO_URL=https://github.com/YOUR_ORG/ai-provider-gateway
RUNNER_TOKEN=
RUNNER_NAME=ai-gateway-runner
RUNNER_LABELS=self-hosted,linux,docker
RUNNER_WORKDIR=_work
RUNNER_EPHEMERAL=false

# Docker network shared with Vault (must resolve vault-prod hostname)
INTERNAL_DOCKER_NETWORK=internal-infra

# Used by deploy workflow on the runner
VAULT_ADDR=https://vault-prod:8200
VAULT_SKIP_VERIFY=true

# Host path mounted into runner for persistent deploy checkout
DEPLOY_HOST_PATH=/opt/ai-provider-gateway

# GID of the host "docker" group (id -G on host, or: getent group docker | cut -d: -f3)
DOCKER_GID=999
