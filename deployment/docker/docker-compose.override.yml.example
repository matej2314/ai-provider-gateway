# Copy to docker-compose.override.yml and customize
# docker-compose.override.yml is gitignored
# This file is automatically loaded by docker-compose alongside docker-compose.yml

version: '3.9'

services:
  gateway:
    environment:
      # Override environment variables here
      # CACHE_ENABLED: "false"  # Disable cache completely
      # PINO_LOG_LEVEL: debug    # Enable debug logs

      # Custom rate limits
      # RATE_LIMIT_RPS_PER_KEY: 50
      # RATE_LIMIT_BURST_PER_KEY: 100

    # Add custom volumes
    # volumes:
    #   - ./custom-gateway.config.yaml:/app/gateway.config.yaml:ro

  # Uncomment to customize Redis settings
  # redis:
  #   command: redis-server --maxmemory 512mb --maxmemory-policy allkeys-lru

  # Uncomment to add extra services (e.g., Redis Commander for debugging)
  # redis-commander:
  #   image: rediscommander/redis-commander:latest
  #   environment:
  #     - REDIS_HOSTS=local:redis:6379
  #   ports:
  #     - "8081:8081"
  #   networks:
  #     - ai-gateway-network